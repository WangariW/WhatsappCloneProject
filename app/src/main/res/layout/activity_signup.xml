<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9D3D3"
    tools:context=".SignupActivity">

    <!-- App Title -->
    <TextView
        android:id="@+id/tvSignupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:fontFamily="cursive"
        android:text="BanterBox"
        android:textAlignment="center"
        android:textColor="#3D647C"
        android:textSize="55sp"
        android:textStyle="bold|italic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sign-up Header -->
    <TextView
        android:id="@+id/tvSignupHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sign Up"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvSignupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Username -->
    <EditText
        android:id="@+id/etUsernameSignup"
        android:layout_width="267dp"
        android:layout_height="51dp"
        android:layout_marginTop="20dp"
        android:hint="Enter username"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/tvSignupHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Email -->
    <EditText
        android:id="@+id/etEmailSignup"
        android:layout_width="267dp"
        android:layout_height="51dp"
        android:layout_marginTop="16dp"
        android:hint="Enter email"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/etUsernameSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Password -->
    <EditText
        android:id="@+id/etPasswordSignup"
        android:layout_width="267dp"
        android:layout_height="51dp"
        android:layout_marginTop="8dp"
        android:hint="Enter password"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/etEmailSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Profile picture -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_profile_circle"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person"
        app:layout_constraintTop_toBottomOf="@id/etPasswordSignup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Upload button -->
    <Button
        android:id="@+id/btnUploadPic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Upload Photo"
        app:layout_constraintTop_toBottomOf="@id/imgProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Terms checkbox -->
    <CheckBox
        android:id="@+id/checkBox"
        android:layout_width="257dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="I agree to the Terms and Conditions"
        android:textColor="#3C509E"
        app:layout_constraintTop_toBottomOf="@id/btnUploadPic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Signup button -->
    <Button
        android:id="@+id/btSignup"
        android:layout_width="262dp"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#566EF2"
        android:text="Sign Up"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/checkBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

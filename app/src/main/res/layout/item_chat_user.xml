<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    android:elevation="3dp"
    app:cardBackgroundColor="@color/colorSurface"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_person"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Online Indicator -->
        <View
            android:id="@+id/onlineIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignEnd="@id/imgProfile"
            android:layout_alignBottom="@id/imgProfile"
            android:background="@drawable/online_dot"
            android:visibility="gone" />

        <!-- Username -->
        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgProfile"
            android:layout_marginStart="12dp"
            android:text="User Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="10:45 PM"
            android:textSize="12sp"
            android:textColor="@color/colorAccent" />

        <!-- Online / Last Seen -->
        <TextView
            android:id="@+id/tvOnlineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvUsername"
            android:layout_toEndOf="@id/imgProfile"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Offline"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary" />

        <!-- Last message -->
        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOnlineStatus"
            android:layout_toEndOf="@id/imgProfile"
            android:layout_toStartOf="@id/tvTimestamp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Hey! How are you?"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:maxLines="1"
            android:ellipsize="end" />


        <View
            android:id="@+id/unreadDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/tvTimestamp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/colorAccent"
            android:background="@drawable/online_dot"
            android:visibility="gone" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
